# Server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=
FEATURE_BUSINESS_ENABLED=true
FEATURE_AI_IMAGES_ENABLED=false
# Set this only when Express is behind a trusted reverse proxy/load balancer.
TRUST_PROXY_HOPS=1

# Authentication (generate a long random value; never commit the real secret)
JWT_SECRET=
JWT_EXPIRES_IN=30d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gabber
DB_USER=postgres
DB_PASSWORD=replace-me

# Redis / OTP state
REDIS_HOST=localhost
REDIS_PORT=6379

# Native Android push notifications. Store the service-account JSON outside
# the repository and restrict it to the account running the PM2 process.
GOOGLE_APPLICATION_CREDENTIALS=/etc/gabber/firebase-service-account.json
FIREBASE_PROJECT_ID=gabber-3f951

# MSG91 OTP. DEV_MODE=true returns OTPs in local API responses and is forbidden in production.
DEV_MODE=true
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# GSTIN Portal verification. Keep the API key only on the server.
GSTIN_PORTAL_BASE_URL=https://www.gstinani.in
GSTIN_PORTAL_API_KEY=

# Optional AI sticker generation
ANTHROPIC_API_KEY=

# Local opt-in AI portrait generation. Keep the key on this server only.
AI_IMAGE_SERVICE_URL=http://127.0.0.1:8010
AI_IMAGE_SERVICE_KEY=

# Optional AWS media storage. Prefer an IAM role instead of static keys on AWS.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_CLOUDFRONT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
